#!/bin/sh
# Pi ¥ patch wrapper — placed early in PATH (~/.pi/agent/bin/pi)
# Patches dist files then delegates to the real pi.

REAL_PI="D:/Program Files/nodejs/node_global/node_modules/@earendil-works/pi-coding-agent/dist/cli.js"

# Run patch hook
powershell -NoProfile -ExecutionPolicy Bypass -File "D:/Program Files/nodejs/node_global/pi-yen-patch.ps1" 2>/dev/null || true

# Delegate to real pi
exec node "$REAL_PI" "$@"
