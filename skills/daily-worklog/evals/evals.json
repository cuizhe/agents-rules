{
  "skill_name": "daily-worklog",
  "evals": [
    {
      "id": 1,
      "eval_name": "自然语言多项目描述",
      "prompt": "我今天做了中移信息充值中心项目的CP评审计划制定，花了1小时；江苏端木OneNET项目的CP评审计划制定，半小时；审计署审计干部培训中心的CP评审备案，半小时；甘肃省畜牧技术推广总站的CP评审备案，半小时。公共部分做了农业项目云服务器续期状态跟踪与退订沟通，1小时。帮我填今天的日报。",
      "expected_output": "正确解析出4个项目工时和1个公共工时，生成预览草稿，合计8小时。保底项目（审计署、甘肃畜牧）应被正确处理。",
      "assertions": [
        {
          "name": "项目数量正确",
          "type": "contains",
          "target": "项目级记录：4"
        },
        {
          "name": "公共工时存在",
          "type": "contains",
          "target": "公共工时"
        },
        {
          "name": "总工时等于8",
          "type": "contains",
          "target": "合计：8.0H"
        }
      ],
      "files": []
    },
    {
      "id": 2,
      "eval_name": "简洁自然语言",
      "prompt": "填日报：民政局AI自动化测试看了半小时，充值中心项目CP评审1小时，公共工时云服务器续期沟通1小时",
      "expected_output": "解析出2个项目工时和1个公共工时，生成预览草稿。",
      "assertions": [
        {
          "name": "项目数量正确",
          "type": "contains",
          "target": "项目级记录：2"
        },
        {
          "name": "公共工时存在",
          "type": "contains",
          "target": "公共工时"
        },
        {
          "name": "AI关键词映射正确",
          "type": "contains",
          "target": "AI工具"
        }
      ],
      "files": []
    },
    {
      "id": 3,
      "eval_name": "随机生成请求",
      "prompt": "今天事情太多记不清了，帮我随机生成一个今天的日报草稿看看",
      "expected_output": "识别为完全随机生成模式，运行 --random full --preview，展示5-6条随机生成的工时记录。",
      "assertions": [
        {
          "name": "使用随机生成模式",
          "type": "contains",
          "target": "--random full"
        },
        {
          "name": "生成记录数量合理",
          "type": "contains",
          "target": "项目级记录："
        },
        {
          "name": "总工时等于8",
          "type": "contains",
          "target": "合计：8.0H"
        }
      ],
      "files": []
    }
  ]
